  <!-- Release x64 uses the locally built LLVM MSVC Ex compiler. The WDK linker and packaging pipeline remain unchanged. -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <CLToolPath>E:\llvm-msvc-ex-2026-7-23\build-release-x64-obf\Release\bin\</CLToolPath>
<CLToolExe>clang-cl.exe</CLToolExe>
    <LinkToolPath>E:\llvm-msvc-ex-2026-7-23\build-release-x64-obf\Release\bin\</LinkToolPath>
    <LinkToolExe>lld-link.exe</LinkToolExe>
    <!--
      混淆 pass 集合 + 可复现种子（单一定义，供所有受混淆单元引用）。

      -aesSeed 的作用：工具链的 OLLVM/xVMP pass 共用 CryptoUtils 的 AES-CTR PRNG，
      它只在传入 -aesSeed 时被确定性播种；否则回落到 CryptGenRandom，导致同一份
      源码每次编译都产出不同的机器码（-fla 的 case 立即数、-const-obfus 的 x/y 全局、
      -ind-call 的地址表、-string-obfus 的密钥长度与填充都会变）。这使"源码 → 二进制"
      不可比对、也无法审计发版产物是否由本仓库构建。

      固定种子后可用两种方式自证可复现：
        msbuild CdpDriver.vcxproj /p:Configuration=Release /p:Platform=x64 /t:Rebuild
      连续两次，比较 x64\Release\CdpDriver.sys 的 SHA-256 应一致。

      注意：受保护节的 CRC 是 DriverEntry 时对"已加载映像"做的运行时快照，
      与构建是否可复现无关，因此固定种子不会影响 O-16 完整性校验。

      另注：现有工具链下 -aesSeed 尚不能做到逐字节可复现——StringObfuscation 自带一个
      未播种的 CryptoUtils 实例（详见 OBFUSCATION_ANALYSIS.md 第 8.3 节）。此处传种子
      的价值是"工具链修好后无需再改项目"，并在本项目内强制所有混淆单元使用同一取值。

      轮换方式：直接覆盖该属性（例如 /p:CdpObfSeed=<32位hex>）即可，无需改各单元。
    -->
    <CdpObfSeed Condition="'$(CdpObfSeed)'==''">5A17C3E90D4B62F18C7E0A3D5B29F461</CdpObfSeed>
    <CdpObfPasses>-mllvm -string-obfus -mllvm -const-obfus -mllvm -ind-call -mllvm -fla -mllvm -aesSeed=$(CdpObfSeed)</CdpObfPasses>
    <CdpObfPassesNoIndCall>-mllvm -string-obfus -mllvm -const-obfus -mllvm -fla -mllvm -aesSeed=$(CdpObfSeed)</CdpObfPassesNoIndCall>
  </PropertyGroup>
